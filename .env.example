# Vercel project settings -> Environment Variables me ye sab add karo

# Django ki secret key (random string, kabhi bhi git me commit mat karo)
SECRET_KEY=your-random-secret-key-here

DEBUG=False

# Comma separated allowed hosts (Vercel domain automatically allow ho jaata hai
# is settings.py me, ye extra ke liye hai agar custom domain lagao)
ALLOWED_HOSTS=*

# Postgres connection string - Neon (neon.tech) ya Supabase (supabase.com) se
# free me mil jaayega. Format aisa hota hai:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
